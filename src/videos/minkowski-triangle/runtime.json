  "narrationSource": {
    "voice": "zh-CN-XiaoxiaoNeural",
    "rate": "+5%",
    "scenes": [
      {
        "id": "01",
        "plannedSeconds": 9.03,
        "cues": [
          {
            "id": "s01-01",
            "text": "这个不等式，用一个三角形就能证明！",
            "voiceText": "这个不等式，用一个三角形就能证明！"
          },
          {
            "id": "s01-02",
            "text": "左边两个根号，右边一个根号。",
            "voiceText": "左边两个根号，右边一个根号，先拆开看。"
          }
        ]
      },
      {
        "id": "02",
        "plannedSeconds": 9.03,
        "cues": [
          {
            "id": "s02-01",
            "text": "√(a²+b²)：直角边a、b的斜边",
            "voiceText": "根号下a方加b方，就是直角边为a和b的斜边。"
          },
          {
            "id": "s02-02",
            "text": "√(c²+d²)：直角边c、d的斜边",
            "voiceText": "根号下c方加d方，也一样。"
          }
        ]
      },
      {
        "id": "03",
        "plannedSeconds": 7.7,
        "cues": [
          {
            "id": "s03-01",
            "text": "把两个直角三角形首尾相接。",
            "voiceText": "把两个直角三角形首尾相接。"
          },
          {
            "id": "s03-02",
            "text": "竖着一共a+c，横着一共b+d。",
            "voiceText": "竖着一共a加c，横着一共b加d。"
          }
        ]
      },
      {
        "id": "04",
        "plannedSeconds": 7.53,
        "cues": [
          {
            "id": "s04-01",
            "text": "连起两端：这条绿边就是\n√((a+c)²+(b+d)²)",
            "voiceText": "连起两端，这条绿边，就是根号下a加c的平方，加b加d的平方。"
          }
        ]
      },
      {
        "id": "05",
        "plannedSeconds": 7.0,
        "cues": [
          {
            "id": "s05-01",
            "text": "两条斜边走折线，绿边走直线：\n两边之和大于第三边！",
            "voiceText": "两条斜边走折线，绿边走直线，三角形两边之和大于第三边！"
          }
        ]
      },
      {
        "id": "06",
        "plannedSeconds": 10.4,
        "cues": [
          {
            "id": "s06-01",
            "text": "a∶b=c∶d时，折线拉直，取等号。",
            "voiceText": "当a比b等于c比d，折线被拉直，就取等号。"
          },
          {
            "id": "s06-02",
            "text": "还想看哪个公式的图形证明？\n评论区告诉我！",
            "voiceText": "还想看哪个公式的图形证明？评论区告诉我！"
          }
        ]
      }
    ]
  },
