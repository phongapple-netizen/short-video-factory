  "captions": [
    {
      "id": "s01-01",
      "text": "这个不等式，用一个三角形就能证明！",
      "voiceText": "这个不等式，用一个三角形就能证明！",
      "scene": "01",
      "start": 0.22,
      "end": 4.274054054054053,
      "audio": null
    },
    {
      "id": "s01-02",
      "text": "左边两个根号，右边一个根号。",
      "voiceText": "左边两个根号，右边一个根号，先拆开看。",
      "scene": "01",
      "start": 4.424054054054054,
      "end": 8.748378378378376,
      "audio": null
    },
    {
      "id": "s02-01",
      "text": "√(a²+b²)：直角边a、b的斜边",
      "voiceText": "根号下a方加b方，就是直角边为a和b的斜边。",
      "scene": "02",
      "start": 9.253333333333334,
      "end": 14.65873873873874,
      "audio": null
    },
    {
      "id": "s02-02",
      "text": "√(c²+d²)：直角边c、d的斜边",
      "voiceText": "根号下c方加d方，也一样。",
      "scene": "02",
      "start": 14.80873873873874,
      "end": 17.78171171171171,
      "audio": null
    },
    {
      "id": "s03-01",
      "text": "把两个直角三角形首尾相接。",
      "voiceText": "把两个直角三角形首尾相接。",
      "scene": "03",
      "start": 18.286666666666665,
      "end": 21.529909909909907,
      "audio": null
    },
    {
      "id": "s03-02",
      "text": "竖着一共a+c，横着一共b+d。",
      "voiceText": "竖着一共a加c，横着一共b加d。",
      "scene": "03",
      "start": 21.67990990990991,
      "end": 25.463693693693692,
      "audio": null
    },
    {
      "id": "s04-01",
      "text": "连起两端：这条绿边就是\n√((a+c)²+(b+d)²)",
      "voiceText": "连起两端，这条绿边，就是根号下a加c的平方，加b加d的平方。",
      "scene": "04",
      "start": 25.986666666666665,
      "end": 33.01369369369369,
      "audio": null
    },
    {
      "id": "s05-01",
      "text": "两条斜边走折线，绿边走直线：\n两边之和大于第三边！",
      "voiceText": "两条斜边走折线，绿边走直线，三角形两边之和大于第三边！",
      "scene": "05",
      "start": 33.519999999999996,
      "end": 40.00648648648648,
      "audio": null
    },
    {
      "id": "s06-01",
      "text": "a∶b=c∶d时，折线拉直，取等号。",
      "voiceText": "当a比b等于c比d，折线被拉直，就取等号。",
      "scene": "06",
      "start": 40.519999999999996,
      "end": 45.38486486486486,
      "audio": null
    },
    {
      "id": "s06-02",
      "text": "还想看哪个公式的图形证明？\n评论区告诉我！",
      "voiceText": "还想看哪个公式的图形证明？评论区告诉我！",
      "scene": "06",
      "start": 45.53486486486486,
      "end": 50.39972972972972,
      "audio": null
    }
  ]
