  "captions": [
    {
      "id": "s01-01",
      "text": "一杯热水，一杯冷水，谁先结冰？",
      "voiceText": "一杯热水，一杯冷水，谁先结冰？",
      "scene": "01",
      "start": 0.22,
      "end": 3.5533333333333332,
      "audio": null
    },
    {
      "id": "s01-02",
      "text": "你肯定选冷水，可有人说：热水！",
      "voiceText": "你肯定选冷水，可有人说：热水！",
      "scene": "01",
      "start": 3.703333333333333,
      "end": 7.036666666666666,
      "audio": null
    },
    {
      "id": "s02-01",
      "text": "热水得先降到冷水的温度，\n再走一遍冷水的路，冷水稳赢吧？",
      "voiceText": "热水得先降到冷水的温度，再走一遍冷水的路，冷水稳赢吧？",
      "scene": "02",
      "start": 7.553333333333333,
      "end": 14.219999999999999,
      "audio": null
    },
    {
      "id": "s03-01",
      "text": "1963年，坦桑尼亚中学生\n姆潘巴做冰淇淋，",
      "voiceText": "一九六三年，坦桑尼亚中学生姆潘巴做冰淇淋，",
      "scene": "03",
      "start": 14.72,
      "end": 19.997777777777777,
      "audio": null
    },
    {
      "id": "s03-02",
      "text": "热的那份反而先冻住，\n这就是“姆潘巴效应”。",
      "voiceText": "热的那份反而先冻住，这就是姆潘巴效应。",
      "scene": "03",
      "start": 20.14777777777778,
      "end": 24.87,
      "audio": null
    },
    {
      "id": "s04-01",
      "text": "2016年精确测量：\n热水降到0°C并不更快。",
      "voiceText": "二零一六年的精确测量说：热水降到零度，并不更快。",
      "scene": "04",
      "start": 25.386666666666663,
      "end": 31.219999999999995,
      "audio": null
    },
    {
      "id": "s04-02",
      "text": "2026年发表的实验测了176次：\n热水多次先结冰！",
      "voiceText": "二零二六年发表的一项实验测了一百七十六次，热水却多次先结冰！",
      "scene": "04",
      "start": 31.369999999999997,
      "end": 39.147777777777776,
      "audio": null
    },
    {
      "id": "s05-01",
      "text": "水到0°C不一定马上结冰，\n零下了还可能是液体，叫“过冷”。",
      "voiceText": "水到零度不一定马上结冰，零下了还可能是液体，这叫过冷。",
      "scene": "05",
      "start": 39.65333333333333,
      "end": 46.31999999999999,
      "audio": null
    },
    {
      "id": "s05-02",
      "text": "哪杯过冷得深，哪杯就晚结冰。",
      "voiceText": "哪杯过冷得深，哪杯就晚结冰。",
      "scene": "05",
      "start": 46.47,
      "end": 49.803333333333335,
      "audio": null
    },
    {
      "id": "s05-03",
      "text": "冰箱里的风也不均匀，\n谁吹得多，谁就冷得快。",
      "voiceText": "冰箱里的冷风也不均匀，谁吹得多，谁就冷得快。",
      "scene": "05",
      "start": 49.95333333333333,
      "end": 55.23111111111111,
      "audio": null
    },
    {
      "id": "s06-01",
      "text": "热水能赢，靠的不是冷得快，\n是冷水过冷，或少吹了风。",
      "voiceText": "所以热水能赢，靠的不是冷得快，而是冷水过冷，或者少吹了风。",
      "scene": "06",
      "start": 55.75333333333333,
      "end": 62.69777777777777,
      "audio": null
    },
    {
      "id": "s06-02",
      "text": "你家冰箱试过吗？评论区说说！",
      "voiceText": "你家冰箱试过吗？评论区说说结果！",
      "scene": "06",
      "start": 62.84777777777778,
      "end": 66.73666666666666,
      "audio": null
    }
  ]
