  "narrationSource": {
    "voice": "zh-CN-XiaoxiaoNeural",
    "rate": "+5%",
    "scenes": [
      {
        "id": "01",
        "plannedSeconds": 7.33,
        "cues": [
          {
            "id": "s01-01",
            "text": "一杯热水，一杯冷水，谁先结冰？",
            "voiceText": "一杯热水，一杯冷水，谁先结冰？"
          },
          {
            "id": "s01-02",
            "text": "你肯定选冷水，可有人说：热水！",
            "voiceText": "你肯定选冷水，可有人说：热水！"
          }
        ]
      },
      {
        "id": "02",
        "plannedSeconds": 7.17,
        "cues": [
          {
            "id": "s02-01",
            "text": "热水得先降到冷水的温度，\n再走一遍冷水的路，冷水稳赢吧？",
            "voiceText": "热水得先降到冷水的温度，再走一遍冷水的路，冷水稳赢吧？"
          }
        ]
      },
      {
        "id": "03",
        "plannedSeconds": 10.67,
        "cues": [
          {
            "id": "s03-01",
            "text": "1963年，坦桑尼亚中学生\n姆潘巴做冰淇淋，",
            "voiceText": "一九六三年，坦桑尼亚中学生姆潘巴做冰淇淋，"
          },
          {
            "id": "s03-02",
            "text": "热的那份反而先冻住，\n这就是“姆潘巴效应”。",
            "voiceText": "热的那份反而先冻住，这就是姆潘巴效应。"
          }
        ]
      },
      {
        "id": "04",
        "plannedSeconds": 14.27,
        "cues": [
          {
            "id": "s04-01",
            "text": "2016年精确测量：\n热水降到0°C并不更快。",
            "voiceText": "二零一六年的精确测量说：热水降到零度，并不更快。"
          },
          {
            "id": "s04-02",
            "text": "2026年发表的实验测了176次：\n热水多次先结冰！",
            "voiceText": "二零二六年发表的一项实验测了一百七十六次，热水却多次先结冰！"
          }
        ]
      },
      {
        "id": "05",
        "plannedSeconds": 16.1,
        "cues": [
          {
            "id": "s05-01",
            "text": "水到0°C不一定马上结冰，\n零下了还可能是液体，叫“过冷”。",
            "voiceText": "水到零度不一定马上结冰，零下了还可能是液体，这叫过冷。"
          },
          {
            "id": "s05-02",
            "text": "哪杯过冷得深，哪杯就晚结冰。",
            "voiceText": "哪杯过冷得深，哪杯就晚结冰。"
          },
          {
            "id": "s05-03",
            "text": "冰箱里的风也不均匀，\n谁吹得多，谁就冷得快。",
            "voiceText": "冰箱里的冷风也不均匀，谁吹得多，谁就冷得快。"
          }
        ]
      },
      {
        "id": "06",
        "plannedSeconds": 11.5,
        "cues": [
          {
            "id": "s06-01",
            "text": "热水能赢，靠的不是冷得快，\n是冷水过冷，或少吹了风。",
            "voiceText": "所以热水能赢，靠的不是冷得快，而是冷水过冷，或者少吹了风。"
          },
          {
            "id": "s06-02",
            "text": "你家冰箱试过吗？评论区说说！",
            "voiceText": "你家冰箱试过吗？评论区说说结果！"
          }
        ]
      }
    ]
  },
