  "narrationSource": {
    "voice": "zh-CN-XiaoxiaoNeural",
    "rate": "+5%",
    "scenes": [
      {
        "id": "01",
        "plannedSeconds": 9.37,
        "cues": [
          {
            "id": "s01-01",
            "text": "你的左手，怎么转都变不成右手。",
            "voiceText": "你的左手，怎么转都变不成右手。"
          },
          {
            "id": "s01-02",
            "text": "分子也分左右手，\n今年诺贝尔化学奖就和它有关。",
            "voiceText": "分子也分左右手，今年诺贝尔化学奖就和它有关。"
          }
        ]
      },
      {
        "id": "02",
        "plannedSeconds": 9.87,
        "cues": [
          {
            "id": "s02-01",
            "text": "左右手互为镜像，就像照镜子。",
            "voiceText": "左右手互为镜像，就像照镜子。"
          },
          {
            "id": "s02-02",
            "text": "可怎么翻怎么转，都没法完全重合，\n这叫“手性”。",
            "voiceText": "可你怎么翻、怎么转，都没法让它们完全重合，这就叫手性。"
          }
        ]
      },
      {
        "id": "03",
        "plannedSeconds": 16.07,
        "cues": [
          {
            "id": "s03-01",
            "text": "一个碳连着四个不同的基团，\n就有一对镜像分子。",
            "voiceText": "一个碳原子连着四个不同的基团，就会有一对镜像分子。"
          },
          {
            "id": "s03-02",
            "text": "转一转试试：总有一个位置对不上。",
            "voiceText": "转一转试试，总有一个位置对不上。"
          },
          {
            "id": "s03-03",
            "text": "如果有两个基团一样，\n镜像就能重合，没有手性。",
            "voiceText": "要是有两个基团一样，镜像就能重合，也就没有手性。"
          }
        ]
      },
      {
        "id": "04",
        "plannedSeconds": 17.4,
        "cues": [
          {
            "id": "s04-01",
            "text": "香芹酮：一种闻着像留兰香，\n它的镜像像葛缕子。",
            "voiceText": "比如香芹酮，一种闻起来像留兰香，它的镜像却像葛缕子。"
          },
          {
            "id": "s04-02",
            "text": "身体里的受体也有手性，\n像手套，只认一只手。",
            "voiceText": "身体里的受体也有手性，像手套一样，只认一只手。"
          },
          {
            "id": "s04-03",
            "text": "所以药物的左手版和右手版，\n作用可能完全不同。",
            "voiceText": "所以药物的左手版和右手版，作用可能完全不同。"
          }
        ]
      },
      {
        "id": "05",
        "plannedSeconds": 18.7,
        "cues": [
          {
            "id": "s05-01",
            "text": "可普通方法造出来，左右各一半，\n就像抛硬币。",
            "voiceText": "可普通方法造出来，左右各占一半，就像抛硬币。"
          },
          {
            "id": "s05-02",
            "text": "衡量偏了多少：\nee =（多的 − 少的）÷ 总数",
            "voiceText": "怎么衡量偏了多少？用多的减去少的，再除以总数，叫做ee。"
          },
          {
            "id": "s05-03",
            "text": "100个里70个左手、30个右手，\nee就是40%。",
            "voiceText": "比如一百个里七十个左手、三十个右手，ee就是百分之四十。"
          }
        ]
      },
      {
        "id": "06",
        "plannedSeconds": 12.23,
        "cues": [
          {
            "id": "s06-01",
            "text": "想多造一种手，要用手性催化剂，\n像一只“左手模具”。",
            "voiceText": "想多造一种手，就要用有手性的催化剂，像一只左手模具。"
          },
          {
            "id": "s06-02",
            "text": "按常理，催化剂纯度打对折，\n产物纯度也打对折。",
            "voiceText": "按常理，催化剂纯度打对折，产物纯度也跟着打对折。"
          }
        ]
      },
      {
        "id": "07",
        "plannedSeconds": 11.2,
        "cues": [
          {
            "id": "s07-01",
            "text": "1986年，卡根发现：\n有的反应不走直线。",
            "voiceText": "一九八六年，卡根发现，有的反应不走直线。"
          },
          {
            "id": "s07-02",
            "text": "催化剂只纯一部分，产物却纯得多，\n叫“正的非线性效应”。",
            "voiceText": "催化剂只纯一部分，产物却纯得多，这叫正的非线性效应。"
          }
        ]
      },
      {
        "id": "08",
        "plannedSeconds": 16.33,
        "cues": [
          {
            "id": "s08-01",
            "text": "一种解释：催化剂会两两配对。",
            "voiceText": "一种解释是，催化剂分子会两两配对。"
          },
          {
            "id": "s08-02",
            "text": "左左、右右能干活；\n一左一右配成的对，罢工。",
            "voiceText": "左左、右右配成的对能干活，一左一右配成的对却罢工了。"
          },
          {
            "id": "s08-03",
            "text": "少数的右手大多被拖去罢工，\n干活的几乎都是左手。",
            "voiceText": "少数的右手大多被拖去罢工，干活的几乎都是左手。"
          }
        ]
      },
      {
        "id": "09",
        "plannedSeconds": 9.6,
        "cues": [
          {
            "id": "s09-01",
            "text": "那能不能让产物自己当催化剂，\n越造越纯？",
            "voiceText": "那能不能让产物自己当催化剂，越造越纯？"
          },
          {
            "id": "s09-02",
            "text": "下集：硖合宪三的“自我复制”反应！",
            "voiceText": "下集，硖合宪三的自我复制反应，记得来看！"
          }
        ]
      }
    ]
  },
