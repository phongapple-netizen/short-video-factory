  "captions": [
    {
      "id": "s01-01",
      "text": "你的左手，怎么转都变不成右手。",
      "voiceText": "你的左手，怎么转都变不成右手。",
      "scene": "01",
      "start": 0.22,
      "end": 3.6410526315789475,
      "audio": null
    },
    {
      "id": "s01-02",
      "text": "分子也分左右手，\n今年诺贝尔化学奖就和它有关。",
      "voiceText": "分子也分左右手，今年诺贝尔化学奖就和它有关。",
      "scene": "01",
      "start": 3.7910526315789475,
      "end": 9.05421052631579,
      "audio": null
    },
    {
      "id": "s02-01",
      "text": "左右手互为镜像，就像照镜子。",
      "voiceText": "左右手互为镜像，就像照镜子。",
      "scene": "02",
      "start": 9.586666666666668,
      "end": 12.744561403508772,
      "audio": null
    },
    {
      "id": "s02-02",
      "text": "可怎么翻怎么转，都没法完全重合，\n这叫“手性”。",
      "voiceText": "可你怎么翻、怎么转，都没法让它们完全重合，这就叫手性。",
      "scene": "02",
      "start": 12.894561403508773,
      "end": 18.94719298245614,
      "audio": null
    },
    {
      "id": "s03-01",
      "text": "一个碳连着四个不同的基团，\n就有一对镜像分子。",
      "voiceText": "一个碳原子连着四个不同的基团，就会有一对镜像分子。",
      "scene": "03",
      "start": 19.453333333333333,
      "end": 25.505964912280703,
      "audio": null
    },
    {
      "id": "s03-02",
      "text": "转一转试试：总有一个位置对不上。",
      "voiceText": "转一转试试，总有一个位置对不上。",
      "scene": "03",
      "start": 25.6559649122807,
      "end": 29.340175438596493,
      "audio": null
    },
    {
      "id": "s03-03",
      "text": "如果有两个基团一样，\n镜像就能重合，没有手性。",
      "voiceText": "要是有两个基团一样，镜像就能重合，也就没有手性。",
      "scene": "03",
      "start": 29.49017543859649,
      "end": 35.01649122807017,
      "audio": null
    },
    {
      "id": "s04-01",
      "text": "香芹酮：一种闻着像留兰香，\n它的镜像像葛缕子。",
      "voiceText": "比如香芹酮，一种闻起来像留兰香，它的镜像却像葛缕子。",
      "scene": "04",
      "start": 35.519999999999996,
      "end": 41.572631578947366,
      "audio": null
    },
    {
      "id": "s04-02",
      "text": "身体里的受体也有手性，\n像手套，只认一只手。",
      "voiceText": "身体里的受体也有手性，像手套一样，只认一只手。",
      "scene": "04",
      "start": 41.722631578947365,
      "end": 46.98578947368421,
      "audio": null
    },
    {
      "id": "s04-03",
      "text": "所以药物的左手版和右手版，\n作用可能完全不同。",
      "voiceText": "所以药物的左手版和右手版，作用可能完全不同。",
      "scene": "04",
      "start": 47.135789473684206,
      "end": 52.39894736842105,
      "audio": null
    },
    {
      "id": "s05-01",
      "text": "可普通方法造出来，左右各一半，\n就像抛硬币。",
      "voiceText": "可普通方法造出来，左右各占一半，就像抛硬币。",
      "scene": "05",
      "start": 52.919999999999995,
      "end": 57.919999999999995,
      "audio": null
    },
    {
      "id": "s05-02",
      "text": "衡量偏了多少：\nee =（多的 − 少的）÷ 总数",
      "voiceText": "怎么衡量偏了多少？用多的减去少的，再除以总数，叫做ee。",
      "scene": "05",
      "start": 58.06999999999999,
      "end": 64.3857894736842,
      "audio": null
    },
    {
      "id": "s05-03",
      "text": "100个里70个左手、30个右手，\nee就是40%。",
      "voiceText": "比如一百个里七十个左手、三十个右手，ee就是百分之四十。",
      "scene": "05",
      "start": 64.5357894736842,
      "end": 71.11473684210526,
      "audio": null
    },
    {
      "id": "s06-01",
      "text": "想多造一种手，要用手性催化剂，\n像一只“左手模具”。",
      "voiceText": "想多造一种手，就要用有手性的催化剂，像一只左手模具。",
      "scene": "06",
      "start": 71.61999999999999,
      "end": 77.67263157894736,
      "audio": null
    },
    {
      "id": "s06-02",
      "text": "按常理，催化剂纯度打对折，\n产物纯度也打对折。",
      "voiceText": "按常理，催化剂纯度打对折，产物纯度也跟着打对折。",
      "scene": "06",
      "start": 77.82263157894737,
      "end": 83.34894736842105,
      "audio": null
    },
    {
      "id": "s07-01",
      "text": "1986年，卡根发现：\n有的反应不走直线。",
      "voiceText": "一九八六年，卡根发现，有的反应不走直线。",
      "scene": "07",
      "start": 83.85333333333332,
      "end": 88.32701754385964,
      "audio": null
    },
    {
      "id": "s07-02",
      "text": "催化剂只纯一部分，产物却纯得多，\n叫“正的非线性效应”。",
      "voiceText": "催化剂只纯一部分，产物却纯得多，这叫正的非线性效应。",
      "scene": "07",
      "start": 88.47701754385965,
      "end": 94.52964912280702,
      "audio": null
    },
    {
      "id": "s08-01",
      "text": "一种解释：催化剂会两两配对。",
      "voiceText": "一种解释是，催化剂分子会两两配对。",
      "scene": "08",
      "start": 95.05333333333333,
      "end": 99.00070175438596,
      "audio": null
    },
    {
      "id": "s08-02",
      "text": "左左、右右能干活；\n一左一右配成的对，罢工。",
      "voiceText": "左左、右右配成的对能干活，一左一右配成的对却罢工了。",
      "scene": "08",
      "start": 99.15070175438596,
      "end": 105.20333333333333,
      "audio": null
    },
    {
      "id": "s08-03",
      "text": "少数的右手大多被拖去罢工，\n干活的几乎都是左手。",
      "voiceText": "少数的右手大多被拖去罢工，干活的几乎都是左手。",
      "scene": "08",
      "start": 105.35333333333334,
      "end": 110.87964912280702,
      "audio": null
    },
    {
      "id": "s09-01",
      "text": "那能不能让产物自己当催化剂，\n越造越纯？",
      "voiceText": "那能不能让产物自己当催化剂，越造越纯？",
      "scene": "09",
      "start": 111.38666666666666,
      "end": 115.86035087719297,
      "audio": null
    },
    {
      "id": "s09-02",
      "text": "下集：硖合宪三的“自我复制”反应！",
      "voiceText": "下集，硖合宪三的自我复制反应，记得来看！",
      "scene": "09",
      "start": 116.01035087719298,
      "end": 120.48403508771929,
      "audio": null
    }
  ]
}
