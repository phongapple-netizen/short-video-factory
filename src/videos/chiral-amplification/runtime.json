    "scenes": [
      {
        "id": "01",
        "plannedSeconds": 9.03,
        "cues": [
          {
            "id": "s01-01",
            "text": "一丁点偏心，三轮后几乎全变成一种！",
            "voiceText": "一丁点偏心，三轮后几乎全变成一种！"
          },
          {
            "id": "s01-02",
            "text": "这是2026年诺贝尔化学奖的发现。",
            "voiceText": "这是二零二六年诺贝尔化学奖的发现。"
          }
        ]
      },
      {
        "id": "02",
        "plannedSeconds": 13.8,
        "cues": [
          {
            "id": "s02-01",
            "text": "很多分子像左右手：互为镜像，\n却不能重合。",
            "voiceText": "很多分子像左右手，互为镜像，却不能重合。"
          },
          {
            "id": "s02-02",
            "text": "药物的左手版和右手版，\n作用可能完全不同。",
            "voiceText": "药物的左手版和右手版，作用可能完全不同。"
          },
          {
            "id": "s02-03",
            "text": "可普通方法造出来，左右各一半。",
            "voiceText": "可普通方法造出来，左右各一半。"
          }
        ]
      },
      {
        "id": "03",
        "plannedSeconds": 11.73,
        "cues": [
          {
            "id": "s03-01",
            "text": "卡根发现：催化剂只纯一部分，\n产物却可能纯得多。",
            "voiceText": "卡根发现：催化剂只纯一部分，产物却可能纯得多。"
          },
          {
            "id": "s03-02",
            "text": "一种解释：左右手配对就“失效”，\n多出来的那种说了算。",
            "voiceText": "一种解释：左右手配对就失效，多出来的那种说了算。"
          }
        ]
      },
      {
        "id": "04",
        "plannedSeconds": 13.1,
        "cues": [
          {
            "id": "s04-01",
            "text": "硖合宪三的反应：产物会帮着\n造出同一种手的自己。",
            "voiceText": "硖合宪三的反应，产物会帮着造出同一种手的自己。"
          },
          {
            "id": "s04-02",
            "text": "第一轮57%，第二轮99%，\n第三轮超过99.5%！",
            "voiceText": "第一轮百分之五十七，第二轮九十九，第三轮超过九十九点五！"
          }
        ]
      },
      {
        "id": "05",
        "plannedSeconds": 14.07,
        "cues": [
          {
            "id": "s05-01",
            "text": "生命里的氨基酸，几乎都是左手型。",
            "voiceText": "生命里的氨基酸，几乎都是左手型。"
          },
          {
            "id": "s05-02",
            "text": "这种放大，给“一点偏差变成全部”\n提供了一种可能。",
            "voiceText": "这种放大，给一点偏差变成全部，提供了一种可能。"
          },
          {
            "id": "s05-03",
            "text": "最初那一点偏差从哪来？评论区聊聊！",
            "voiceText": "最初那一点偏差从哪来？评论区聊聊！"
          }
        ]
      }
    ]
  },
