  "captions": [
    {
      "id": "s01-01",
      "text": "一丁点偏心，三轮后几乎全变成一种！",
      "voiceText": "一丁点偏心，三轮后几乎全变成一种！",
      "scene": "01",
      "start": 0.22,
      "end": 4.274054054054053,
      "audio": null
    },
    {
      "id": "s01-02",
      "text": "这是2026年诺贝尔化学奖的发现。",
      "voiceText": "这是二零二六年诺贝尔化学奖的发现。",
      "scene": "01",
      "start": 4.424054054054054,
      "end": 8.748378378378376,
      "audio": null
    },
    {
      "id": "s02-01",
      "text": "很多分子像左右手：互为镜像，\n却不能重合。",
      "voiceText": "很多分子像左右手，互为镜像，却不能重合。",
      "scene": "02",
      "start": 9.253333333333334,
      "end": 13.847927927927929,
      "audio": null
    },
    {
      "id": "s02-02",
      "text": "药物的左手版和右手版，\n作用可能完全不同。",
      "voiceText": "药物的左手版和右手版，作用可能完全不同。",
      "scene": "02",
      "start": 13.997927927927929,
      "end": 18.862792792792796,
      "audio": null
    },
    {
      "id": "s02-03",
      "text": "可普通方法造出来，左右各一半。",
      "voiceText": "可普通方法造出来，左右各一半。",
      "scene": "02",
      "start": 19.012792792792794,
      "end": 22.526306306306306,
      "audio": null
    },
    {
      "id": "s03-01",
      "text": "卡根发现：催化剂只纯一部分，\n产物却可能纯得多。",
      "voiceText": "卡根发现：催化剂只纯一部分，产物却可能纯得多。",
      "scene": "03",
      "start": 23.053333333333335,
      "end": 28.458738738738738,
      "audio": null
    },
    {
      "id": "s03-02",
      "text": "一种解释：左右手配对就“失效”，\n多出来的那种说了算。",
      "voiceText": "一种解释：左右手配对就失效，多出来的那种说了算。",
      "scene": "03",
      "start": 28.60873873873874,
      "end": 34.284414414414414,
      "audio": null
    },
    {
      "id": "s04-01",
      "text": "硖合宪三的反应：产物会帮着\n造出同一种手的自己。",
      "voiceText": "硖合宪三的反应，产物会帮着造出同一种手的自己。",
      "scene": "04",
      "start": 34.78666666666667,
      "end": 40.462342342342346,
      "audio": null
    },
    {
      "id": "s04-02",
      "text": "第一轮57%，第二轮99%，\n第三轮超过99.5%！",
      "voiceText": "第一轮百分之五十七，第二轮九十九，第三轮超过九十九点五！",
      "scene": "04",
      "start": 40.612342342342345,
      "end": 47.3690990990991,
      "audio": null
    },
    {
      "id": "s05-01",
      "text": "生命里的氨基酸，几乎都是左手型。",
      "voiceText": "生命里的氨基酸，几乎都是左手型。",
      "scene": "05",
      "start": 47.88666666666667,
      "end": 51.67045045045045,
      "audio": null
    },
    {
      "id": "s05-02",
      "text": "这种放大，给“一点偏差变成全部”\n提供了一种可能。",
      "voiceText": "这种放大，给一点偏差变成全部，提供了一种可能。",
      "scene": "05",
