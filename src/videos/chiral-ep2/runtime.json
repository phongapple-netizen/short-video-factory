  "captions": [
    {
      "id": "s01-01",
      "text": "两百万个分子里，左手只多1个。",
      "voiceText": "两百万个分子里，左手只多一个。",
      "scene": "01",
      "start": 0.22,
      "end": 3.6410526315789475,
      "audio": null
    },
    {
      "id": "s01-02",
      "text": "三轮反应后，几乎全成了左手！\n这就是硖合反应。",
      "voiceText": "三轮反应后，几乎全成了左手！这就是硖合反应。",
      "scene": "01",
      "start": 3.7910526315789475,
      "end": 8.791052631578948,
      "audio": null
    },
    {
      "id": "s02-01",
      "text": "上集说到：分子有左右手，\nee表示偏了多少。",
      "voiceText": "上集说到，分子有左右手，ee表示偏了多少。",
      "scene": "02",
      "start": 9.32,
      "end": 14.056842105263158,
      "audio": null
    },
    {
      "id": "s02-02",
      "text": "两百万个里多1个，\nee只有0.00005%。",
      "voiceText": "两百万个里只多一个，ee只有百分之零点零零零零五。",
      "scene": "02",
      "start": 14.20684210526316,
      "end": 20.25947368421053,
      "audio": null
    },
    {
      "id": "s03-01",
      "text": "硖合发现：这个反应的产物，\n自己就是催化剂。",
      "voiceText": "硖合发现，这个反应的产物，自己就是催化剂。",
      "scene": "03",
      "start": 20.786666666666665,
      "end": 25.523508771929823,
      "audio": null
    },
    {
      "id": "s03-02",
      "text": "左手产物帮着造左手，\n右手产物帮着造右手。",
      "voiceText": "左手产物帮着造左手，右手产物帮着造右手。",
      "scene": "03",
      "start": 25.673508771929825,
      "end": 30.410350877192982,
      "audio": null
    },
    {
      "id": "s04-01",
      "text": "可左右手按同样速度复制，\n比例根本不会变！",
      "voiceText": "可如果左右手按同样速度复制，比例根本不会变！",
      "scene": "04",
      "start": 30.919999999999998,
      "end": 36.18315789473684,
      "audio": null
    },
    {
      "id": "s04-02",
      "text": "51∶49，翻倍后102∶98，\n比例没变。",
      "voiceText": "五十一比四十九，翻倍后是一百零二比九十八，比例一点没变。",
      "scene": "04",
      "start": 36.33315789473684,
      "end": 42.9121052631579,
      "audio": null
    },
    {
      "id": "s05-01",
      "text": "关键：左右手会配对，\n一左一右配成的对就“罢工”。",
      "voiceText": "关键在于，左右手会配对，一左一右配成的对就罢工了。",
      "scene": "05",
      "start": 43.42,
      "end": 49.20947368421053,
      "audio": null
    },
    {
      "id": "s05-02",
      "text": "每次配对，左右各少一个，\n两边的差却一点不少。",
      "voiceText": "每次配对，左右各少一个，两边的差却一点不少。",
      "scene": "05",
      "start": 49.35947368421053,
      "end": 54.35947368421053,
      "audio": null
    },
    {
      "id": "s05-03",
      "text": "少数派越来越少，偏差就被放大了。",
      "voiceText": "少数派越来越少，偏差就被一轮轮放大了。",
      "scene": "05",
      "start": 54.509473684210526,
      "end": 58.98315789473684,
      "audio": null
    },
    {
      "id": "s06-01",
      "text": "2003年的实验：从约0.00005%出发，",
      "voiceText": "二零零三年的实验，从约百分之零点零零零零五出发，",
      "scene": "06",
      "start": 59.486666666666665,
      "end": 65.27614035087718,
      "audio": null
    },
    {
      "id": "s06-02",
      "text": "第一轮57%，第二轮99%，\n第三轮超过99.5%！",
      "voiceText": "第一轮百分之五十七，第二轮九十九，第三轮超过九十九点五！",
      "scene": "06",
      "start": 65.42614035087719,
      "end": 72.00508771929825,
      "audio": null
    },
    {
      "id": "s07-01",
      "text": "一点点偏差，靠反应自己\n就能放大成几乎全部。",
      "voiceText": "这说明一点点偏差，靠反应自己就能放大成几乎全部。",
      "scene": "07",
      "start": 72.52,
      "end": 78.30947368421052,
      "audio": null
    },
    {
      "id": "s07-02",
      "text": "生命里的氨基酸几乎都是左手型，\n这种放大是一种可能的解释。",
      "voiceText": "生命里的氨基酸几乎都是左手型，这种放大是一种可能的解释。",
      "scene": "07",
      "start": 78.45947368421052,
      "end": 85.30157894736841,
      "audio": null
    },
    {
      "id": "s07-03",
      "text": "最初那一点偏差从哪来？\n至今还在研究。评论区聊聊！",
      "voiceText": "最初那一点偏差从哪来？至今还在研究，评论区聊聊！",
      "scene": "07",
      "start": 85.45157894736842,
      "end": 90.9778947368421,
      "audio": null
    }
