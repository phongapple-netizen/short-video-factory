  "captions": [
    {
      "id": "s01-01",
      "text": "三个一样的铁球，同时剪断，谁先落地？",
      "voiceText": "三个一样的铁球，同时剪断，谁先落地？",
      "scene": "01",
      "start": 0.22,
      "end": 4.274054054054053,
      "audio": null
    },
    {
      "id": "s01-02",
      "text": "A剪弹簧上的绳，B剪弹簧中间，C剪绳。",
      "voiceText": "A剪弹簧上的绳，B剪弹簧中间，C剪绳。",
      "scene": "01",
      "start": 4.424054054054054,
      "end": 8.748378378378376,
      "audio": null
    },
    {
      "id": "s01-03",
      "text": "先在心里选一个！",
      "voiceText": "先在心里选一个！",
      "scene": "01",
      "start": 8.898378378378379,
      "end": 10.79027027027027,
      "audio": null
    },
    {
      "id": "s02-01",
      "text": "很多人想：弹簧还拉着球，\nA和B会慢一拍。",
      "voiceText": "很多人想：弹簧还拉着球，A和B会慢一拍。",
      "scene": "02",
      "start": 11.32,
      "end": 15.914594594594595,
      "audio": null
    },
    {
      "id": "s02-02",
      "text": "实际放一遍：三个球几乎同时落地！",
      "voiceText": "实际放一遍：三个球几乎同时落地！",
      "scene": "02",
      "start": 16.064594594594595,
      "end": 19.848378378378378,
      "audio": null
    },
    {
      "id": "s03-01",
      "text": "可是慢放400倍，\nA的球剪断后竟然悬在空中！",
      "voiceText": "可是慢放四百倍，A的球剪断后竟然悬在空中！",
      "scene": "03",
      "start": 20.35333333333333,
      "end": 25.48846846846847,
      "audio": null
    },
    {
      "id": "s03-02",
      "text": "弹簧上端先缩下来，\n下端要过16毫秒才收到消息。",
      "voiceText": "弹簧上端先缩下来，下端要过十六毫秒才收到消息。",
      "scene": "03",
      "start": 25.638468468468467,
      "end": 31.314144144144144,
      "audio": null
    },
    {
      "id": "s04-01",
      "text": "球和弹簧看成整体，只受重力，\n重心立刻自由下落。",
      "voiceText": "球和弹簧看成整体，只受重力，重心立刻自由下落。",
      "scene": "04",
      "start": 31.82,
      "end": 37.225405405405404,
      "audio": null
    },
    {
      "id": "s04-02",
      "text": "缩完以后球被带着往下走，\n只落后大约1毫米。",
      "voiceText": "缩完以后球被带着往下走，只落后大约一毫米。",
      "scene": "04",
      "start": 37.3754054054054,
      "end": 42.51054054054054,
      "audio": null
    },
    {
      "id": "s05-01",
      "text": "落地时A只晚0.25毫秒，B更少，\n眼睛分不出，所以选D。",
      "voiceText": "落地时A只晚零点二五毫秒，B更少，眼睛分不出，所以选D。",
      "scene": "05",
      "start": 43.019999999999996,
      "end": 49.50648648648648,
      "audio": null
    },
    {
      "id": "s06-01",
      "text": "拿彩虹圈从上端松手试试！",
      "voiceText": "想亲眼看悬停？拿彩虹圈从上端松手试试。",
      "scene": "06",
