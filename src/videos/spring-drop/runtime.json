    "scenes": [
      {
        "id": "01",
        "plannedSeconds": 11.1,
        "cues": [
          {
            "id": "s01-01",
            "text": "三个一样的铁球，同时剪断，谁先落地？",
            "voiceText": "三个一样的铁球，同时剪断，谁先落地？"
          },
          {
            "id": "s01-02",
            "text": "A剪弹簧上的绳，B剪弹簧中间，C剪绳。",
            "voiceText": "A剪弹簧上的绳，B剪弹簧中间，C剪绳。"
          },
          {
            "id": "s01-03",
            "text": "先在心里选一个！",
            "voiceText": "先在心里选一个！"
          }
        ]
      },
      {
        "id": "02",
        "plannedSeconds": 9.03,
        "cues": [
          {
            "id": "s02-01",
            "text": "很多人想：弹簧还拉着球，\nA和B会慢一拍。",
            "voiceText": "很多人想：弹簧还拉着球，A和B会慢一拍。"
          },
          {
            "id": "s02-02",
            "text": "实际放一遍：三个球几乎同时落地！",
            "voiceText": "实际放一遍：三个球几乎同时落地！"
          }
        ]
      },
      {
        "id": "03",
        "plannedSeconds": 11.47,
        "cues": [
          {
            "id": "s03-01",
            "text": "可是慢放400倍，\nA的球剪断后竟然悬在空中！",
            "voiceText": "可是慢放四百倍，A的球剪断后竟然悬在空中！"
          },
          {
            "id": "s03-02",
            "text": "弹簧上端先缩下来，\n下端要过16毫秒才收到消息。",
            "voiceText": "弹簧上端先缩下来，下端要过十六毫秒才收到消息。"
          }
        ]
      },
      {
        "id": "04",
        "plannedSeconds": 11.2,
        "cues": [
          {
            "id": "s04-01",
            "text": "球和弹簧看成整体，只受重力，\n重心立刻自由下落。",
            "voiceText": "球和弹簧看成整体，只受重力，重心立刻自由下落。"
          },
          {
            "id": "s04-02",
            "text": "缩完以后球被带着往下走，\n只落后大约1毫米。",
            "voiceText": "缩完以后球被带着往下走，只落后大约一毫米。"
          }
        ]
      },
      {
        "id": "05",
        "plannedSeconds": 7.0,
        "cues": [
          {
            "id": "s05-01",
            "text": "落地时A只晚0.25毫秒，B更少，\n眼睛分不出，所以选D。",
            "voiceText": "落地时A只晚零点二五毫秒，B更少，眼睛分不出，所以选D。"
          }
        ]
      },
      {
        "id": "06",
        "plannedSeconds": 9.3,
        "cues": [
          {
            "id": "s06-01",
            "text": "拿彩虹圈从上端松手试试！",
            "voiceText": "想亲眼看悬停？拿彩虹圈从上端松手试试。"
          },
          {
            "id": "s06-02",
            "text": "你一开始选的是几？评论区报答案！",
            "voiceText": "你一开始选的是几？评论区报个答案！"
          }
        ]
      }
    ]
  },
