[
 {
  "start": 0.6,
  "end": 3.3360000000000003,
  "text": "五个海盗，一百枚金币。"
 },
 {
  "start": 3.6860000000000004,
  "end": 8.738235294117647,
  "text": "第一个海盗怎么分，才能保住性命，还能拿最多？"
 },
 {
  "start": 8.738235294117647,
  "end": 12.642235294117647,
  "text": "答案很反直觉：他一个人拿九十八枚。"
 },
 {
  "start": 12.642235294117647,
  "end": 13.560823529411765,
  "text": "为什么？"
 },
 {
  "start": 13.560823529411765,
  "end": 15.398,
  "text": "我们一步一步推。"
 },
 {
  "start": 16.8,
  "end": 18.14,
  "text": "先看规则。"
 },
 {
  "start": 18.14,
  "end": 24.572000000000003,
  "text": "五个海盗，按资历从高到低，叫A、B、C、D、E。"
 },
 {
  "start": 24.572000000000003,
  "end": 28.056,
  "text": "A资历最高，先提分配方案。"
 },
 {
  "start": 29.46666666666667,
  "end": 33.45710569105691,
  "text": "然后所有人投票，包括提议的人自己。"
 },
 {
  "start": 33.45710569105691,
  "end": 39.09066666666667,
  "text": "同意的人数达到一半或以上，方案就通过，照这个分。"
 },
 {
  "start": 40.5,
  "end": 47.268,
  "text": "如果没通过，提议的人就被扔下海，轮到下一个人提方案，再投票。"
 },
 {
  "start": 48.699999999999996,
  "end": 52.13102040816326,
  "text": "最后一条：所有海盗都绝顶聪明。"
 },
 {
  "start": 52.13102040816326,
  "end": 59.907999999999994,
  "text": "他们的优先级是：先保命，再多拿金币，收益一样的话，更愿意看别人下海。"
 },
 {
  "start": 61.33333333333333,
  "end": 62.372392156862745,
  "text": "怎么想？"
 },
 {
  "start": 62.372392156862745,
  "end": 66.00909803921569,
  "text": "别从A开始，从最后面倒着推。"
 },
 {
  "start": 66.00909803921569,
  "end": 70.16533333333334,
  "text": "因为越往后，人越少，局面越简单。"
 },
 {
  "start": 71.56666666666665,
  "end": 75.7294492753623,
  "text": "假设前面三个人都没了，只剩D和E。"
 },
 {
  "start": 75.7294492753623,
  "end": 79.64736231884056,
  "text": "D提方案：一百枚全归我，E零枚。"
 },
 {
  "start": 79.64736231884056,
  "end": 85.52423188405795,
  "text": "投票时，D同意，E反对，一比一，刚好一半，通过。"
 },
 {
  "start": 85.52423188405795,
  "end": 88.46266666666665,
  "text": "所以只剩两人时，D全拿。"
 },
 {
  "start": 89.86666666666665,
  "end": 92.12069019607841,
  "text": "再加上C，三个人。"
 },
 {
  "start": 92.12069019607841,
  "end": 96.87918431372547,
  "text": "C要拿到两票，自己一票，还要再拉一票。"
 },
 {
  "start": 96.87918431372547,
  "end": 102.38901960784312,
  "text": "D不会同意，因为C被扔下海后，D能拿一百枚。"
 },
 {
  "start": 102.38901960784312,
  "end": 103.14036078431371,
  "text": "E呢？"
 },
 {
  "start": 103.14036078431371,
  "end": 106.64661960784312,
  "text": "C被扔下海，E一枚也拿不到。"
 },
 {
  "start": 106.64661960784312,
  "end": 111.15466666666664,
  "text": "所以C只要给E一枚，E就愿意投同意。"
 },
 {
  "start": 111.50466666666665,
  "end": 115.51986666666666,
  "text": "方案：C九十九，D零，E一。"
 },
 {
  "start": 115.51986666666666,
  "end": 117.24066666666666,
  "text": "两票，通过。"
 },
 {
  "start": 118.66666666666664,
  "end": 120.87090763052207,
  "text": "再加上B，四个人。"
 },
 {
  "start": 120.87090763052207,
  "end": 125.03447389558231,
  "text": "B要两票，自己一票，再买一票就够。"
 },
 {
  "start": 125.03447389558231,
  "end": 129.68787148594376,
  "text": "收买价，就是对方下一轮能拿的数，加一。"
 },
 {
  "start": 129.68787148594376,
  "end": 134.0963534136546,
  "text": "如果B被扔下海，D是零枚，只要一枚；"
 },
 {
  "start": 134.0963534136546,
  "end": 136.30059437751004,
  "text": "E是一枚，要两枚。"
 },
 {
  "start": 136.30059437751004,
  "end": 138.99466666666663,
  "text": "选最便宜的：给D一枚。"
 },
 {
  "start": 139.34466666666665,
  "end": 144.2051884057971,
  "text": "方案：B九十九，C零，D一，E零。"
 },
 {
  "start": 144.2051884057971,
  "end": 145.92066666666665,
  "text": "两票，通过。"
 },
 {
  "start": 147.33333333333331,
  "end": 149.26979047619045,
  "text": "终于轮到五个人。"
 },
 {
  "start": 149.26979047619045,
  "end": 152.9006476190476,
  "text": "A要三票，自己一票，还要两票。"
 },
 {
  "start": 152.9006476190476,
  "end": 158.46796190476186,
  "text": "如果A被扔下海，C和E都是零枚，收买价都是一；"
 },
 {
  "start": 158.46796190476186,
  "end": 160.64647619047614,
  "text": "D是一枚，要两枚。"
 },
 {
  "start": 160.64647619047614,
  "end": 164.2773333333333,
  "text": "选最便宜的两个：C和E各一枚。"
 },
 {
  "start": 164.62733333333333,
  "end": 170.23964102564102,
  "text": "方案：A九十八，B零，C一，D零，E一。"
 },
 {
  "start": 170.23964102564102,
  "end": 171.92333333333332,
  "text": "三票，通过。"
 },
 {
  "start": 173.33333333333331,
  "end": 176.9665641025641,
  "text": "有人会问：C和E为什么接受一枚？"
 },
 {
  "start": 176.9665641025641,
  "end": 182.1893333333333,
  "text": "因为拒绝的话，下一轮还是零枚，一枚也比零枚强。"
 },
 {
  "start": 182.5393333333333,
  "end": 184.92087179487177,
  "text": "B和D为什么不反对？"
 },
 {
  "start": 184.92087179487177,
  "end": 188.7313333333333,
  "text": "他们反对也没用，A有三票就过了。"
 },
 {
  "start": 189.0813333333333,
  "end": 192.44133333333332,
  "text": "还有人问：A为什么不多给几枚？"
 },
 {
  "start": 192.44133333333332,
  "end": 193.33733333333333,
  "text": "不需要。"
 },
 {
  "start": 193.33733333333333,
  "end": 199.16133333333332,
  "text": "对聪明人来说，只要比下一轮多一点点，就能买到这一票。"
 },
 {
  "start": 200.56666666666663,
  "end": 211.34266666666664,
  "text": "规律是：每一轮，提议者只收买下一轮会拿零枚的人，每人一枚，凑够刚好过半的票，剩下的全归自己。"
 },
 {
  "start": 213.56666666666663,
  "end": 220.16666666666663,
  "text": "如果规则改成必须超过一半才通过，A最多只能拿九十七枚。"
 },
 {
  "start": 220.16666666666663,
  "end": 223.58888888888885,
  "text": "规则小改一点，结果就大不同。"
 },
 {
  "start": 223.58888888888885,
  "end": 225.05555555555551,
  "text": "你算对了吗？"
 },
 {
  "start": 225.05555555555551,
  "end": 226.76666666666662,
  "text": "评论区告诉我。"
 }
]