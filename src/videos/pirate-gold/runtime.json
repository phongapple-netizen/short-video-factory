  "captions": [
    {
      "id": "s01-01",
      "scene": "01",
      "text": "五个海盗，一百枚金币。",
      "start": 0.6,
      "end": 3.3360000000000003,
      "duration": 2.736,
      "audio": "assets/pirate-gold/audio/s01-01-4a050fa6b7e2c5c1.mp3"
    },
    {
      "id": "s01-02",
      "scene": "01",
      "text": "A拿98枚，为什么？",
      "start": 3.6860000000000004,
      "end": 15.398,
      "duration": 11.712,
      "audio": "assets/pirate-gold/audio/s01-02-862e5455a6337fda.mp3"
    },
    {
      "id": "s02-01",
      "scene": "02",
      "text": "按资历排序，A先提方案。",
      "start": 16.8,
      "end": 28.056,
      "duration": 11.256,
      "audio": "assets/pirate-gold/audio/s02-01-1aeec1cf55a55cab.mp3"
    },
    {
      "id": "s03-01",
      "scene": "03",
      "text": "所有人投票，同意≥一半就通过。",
      "start": 29.46666666666667,
      "end": 39.09066666666667,
      "duration": 9.624,
      "audio": "assets/pirate-gold/audio/s03-01-568f053d3d74f76d.mp3"
    },
    {
      "id": "s04-01",
      "scene": "04",
      "text": "不通过：提议者下海，下一位提。",
      "start": 40.5,
      "end": 47.268,
      "duration": 6.768,
      "audio": "assets/pirate-gold/audio/s04-01-d5c68b488159ce2f.mp3"
    },
    {
      "id": "s05-01",
      "scene": "05",
      "text": "保命 > 金币 > 看别人下海。",
      "start": 48.699999999999996,
      "end": 59.907999999999994,
      "duration": 11.208,
      "audio": "assets/pirate-gold/audio/s05-01-fd7a6a64b01a4bb8.mp3"
    },
    {
      "id": "s06-01",
      "scene": "06",
      "text": "别从A开始，从最后面倒着推。",
      "start": 61.33333333333333,
      "end": 70.16533333333334,
      "duration": 8.832,
      "audio": "assets/pirate-gold/audio/s06-01-dfecee3672810320.mp3"
    },
    {
      "id": "s07-01",
      "scene": "07",
      "text": "只剩D、E：D 100，E 0。",
      "start": 71.56666666666665,
      "end": 88.46266666666665,
      "duration": 16.896,
      "audio": "assets/pirate-gold/audio/s07-01-9ab07ddf39c008b0.mp3"
    },
    {
      "id": "s08-01",
      "scene": "08",
      "text": "C要拉一票，E最便宜。",
      "start": 89.86666666666665,
      "end": 111.15466666666664,
