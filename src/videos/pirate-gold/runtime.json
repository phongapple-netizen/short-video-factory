  "narrationSource": {
    "voice": "zh-CN-XiaoxiaoNeural",
    "rate": "-5%",
    "scenes": [
      {
        "id": "01",
        "plannedSeconds": 15,
        "cues": [
          {
            "id": "s01-01",
            "text": "五个海盗，一百枚金币。",
            "voiceText": "五个海盗，一百枚金币。"
          },
          {
            "id": "s01-02",
            "text": "A拿98枚，为什么？",
            "voiceText": "第一个海盗怎么分，才能保住性命，还能拿最多？答案很反直觉：他一个人拿九十八枚。为什么？我们一步一步推。"
          }
        ]
      },
      {
        "id": "02",
        "plannedSeconds": 9,
        "cues": [
          {
            "id": "s02-01",
            "text": "按资历排序，A先提方案。",
            "voiceText": "先看规则。五个海盗，按资历从高到低，叫A、B、C、D、E。A资历最高，先提分配方案。"
          }
        ]
      },
      {
        "id": "03",
        "plannedSeconds": 9,
        "cues": [
          {
            "id": "s03-01",
            "text": "所有人投票，同意≥一半就通过。",
            "voiceText": "然后所有人投票，包括提议的人自己。同意的人数达到一半或以上，方案就通过，照这个分。"
          }
        ]
      },
      {
        "id": "04",
        "plannedSeconds": 8,
        "cues": [
          {
            "id": "s04-01",
            "text": "不通过：提议者下海，下一位提。",
            "voiceText": "如果没通过，提议的人就被扔下海，轮到下一个人提方案，再投票。"
          }
        ]
      },
      {
        "id": "05",
        "plannedSeconds": 12,
        "cues": [
          {
            "id": "s05-01",
            "text": "保命 > 金币 > 看别人下海。",
            "voiceText": "最后一条：所有海盗都绝顶聪明。他们的优先级是：先保命，再多拿金币，收益一样的话，更愿意看别人下海。"
          }
        ]
      },
      {
        "id": "06",
        "plannedSeconds": 8,
        "cues": [
          {
            "id": "s06-01",
            "text": "别从A开始，从最后面倒着推。",
            "voiceText": "怎么想？别从A开始，从最后面倒着推。因为越往后，人越少，局面越简单。"
          }
        ]
      },
      {
        "id": "07",
        "plannedSeconds": 16,
        "cues": [
          {
            "id": "s07-01",
            "text": "只剩D、E：D 100，E 0。",
            "voiceText": "假设前面三个人都没了，只剩D和E。D提方案：一百枚全归我，E零枚。投票时，D同意，E反对，一比一，刚好一半，通过。所以只剩两人时，D全拿。"
          }
        ]
      },
      {
        "id": "08",
        "plannedSeconds": 24,
        "cues": [
          {
            "id": "s08-01",
            "text": "C要拉一票，E最便宜。",
            "voiceText": "再加上C，三个人。C要拿到两票，自己一票，还要再拉一票。D不会同意，因为C被扔下海后，D能拿一百枚。E呢？C被扔下海，E一枚也拿不到。所以C只要给E一枚，E就愿意投同意。"
          },
          {
            "id": "s08-02",
            "text": "三人局：C 99，D 0，E 1。",
            "voiceText": "方案：C九十九，D零，E一。两票，通过。"
          }
        ]
      },
      {
        "id": "09",
        "plannedSeconds": 23,
        "cues": [
          {
            "id": "s09-01",
            "text": "B买最便宜的D，一枚。",
            "voiceText": "再加上B，四个人。B要两票，自己一票，再买一票就够。收买价，就是对方下一轮能拿的数，加一。如果B被扔下海，D是零枚，只要一枚；E是一枚，要两枚。选最便宜的：给D一枚。"
          },
          {
            "id": "s09-02",
            "text": "四人局：B 99，C 0，D 1，E 0。",
            "voiceText": "方案：B九十九，C零，D一，E零。两票，通过。"
          }
        ]
      },
      {
        "id": "10",
        "plannedSeconds": 24,
        "cues": [
          {
            "id": "s10-01",
            "text": "A收买C和E，各一枚。",
            "voiceText": "终于轮到五个人。A要三票，自己一票，还要两票。如果A被扔下海，C和E都是零枚，收买价都是一；D是一枚，要两枚。选最便宜的两个：C和E各一枚。"
          },
          {
            "id": "s10-02",
            "text": "五人局：A 98，B 0，C 1，D 0，E 1。",
            "voiceText": "方案：A九十八，B零，C一，D零，E一。三票，通过。"
          }
        ]
      },
      {
        "id": "11",
        "plannedSeconds": 27,
        "cues": [
          {
            "id": "s11-01",
            "text": "C、E为什么接受1枚？",
            "voiceText": "有人会问：C和E为什么接受一枚？因为拒绝的话，下一轮还是零枚，一枚也比零枚强。"
          },
          {
            "id": "s11-02",
            "text": "B、D为什么不反对？",
            "voiceText": "B和D为什么不反对？他们反对也没用，A有三票就过了。"
          },
          {
            "id": "s11-03",
            "text": "A为什么不多给？",
            "voiceText": "还有人问：A为什么不多给几枚？不需要。对聪明人来说，只要比下一轮多一点点，就能买到这一票。"
          }
        ]
      },
      {
        "id": "12",
        "plannedSeconds": 13,
        "cues": [
          {
            "id": "s12-01",
            "text": "只买下一轮拿0枚的人，每人1枚。",
            "voiceText": "规律是：每一轮，提议者只收买下一轮会拿零枚的人，每人一枚，凑够刚好过半的票，剩下的全归自己。"
          }
        ]
      },
      {
        "id": "13",
        "plannedSeconds": 14,
        "cues": [
          {
            "id": "s13-01",
            "text": "必须超过一半，A最多97枚。",
            "voiceText": "如果规则改成必须超过一半才通过，A最多只能拿九十七枚。规则小改一点，结果就大不同。你算对了吗？评论区告诉我。"
          }
        ]
      }
    ]
  }
}
