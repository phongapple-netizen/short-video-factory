      "audio": null
    },
    {
      "id": "s02-01",
      "text": "收买价＝对方下一轮能拿的＋1",
      "voiceText": "上集结论：收买价，是对方下一轮能拿的，再加一。",
      "scene": "02",
      "start": 4.053333333333334,
      "end": 9.331111111111111,
      "audio": null
    },
    {
      "id": "s03-01",
      "text": "四人局：B要2票，再买1票就够。",
      "voiceText": "四人局，B要两票，再买一票就够。",
      "scene": "03",
      "start": 9.853333333333333,
      "end": 13.464444444444444,
      "audio": null
    },
    {
      "id": "s03-02",
      "text": "B下海就成了三人局：\nC 99，D 0，E 1",
      "voiceText": "B下海就成了三人局：C九十九，D零，E一。",
      "scene": "03",
      "start": 13.614444444444445,
      "end": 18.336666666666666,
      "audio": null
    },
    {
      "id": "s03-03",
      "text": "收买价：C 100，D 1，E 2",
      "voiceText": "收买价：C一百，D一，E二。",
      "scene": "03",
      "start": 18.486666666666668,
      "end": 21.264444444444447,
      "audio": null
    },
    {
      "id": "s03-04",
      "text": "买最便宜的D：\nB 99，C 0，D 1，E 0，通过！",
      "voiceText": "B买最便宜的D：九十九，零，一，零，通过！",
      "scene": "03",
      "start": 21.414444444444445,
      "end": 25.581111111111113,
      "audio": null
    },
    {
      "id": "s04-01",
      "text": "五人局：船长要3票，得再买2票。",
      "voiceText": "五人局，船长要三票，得再买两票。",
      "scene": "04",
      "start": 26.086666666666666,
      "end": 29.697777777777777,
      "audio": null
    },
    {
      "id": "s04-02",
      "text": "船长下海就是四人局：\nB 99，C 0，D 1，E 0",
      "voiceText": "船长下海就是四人局：B九十九，C零，D一，E零。",
      "scene": "04",
      "start": 29.84777777777778,
      "end": 35.12555555555556,
      "audio": null
    },
    {
      "id": "s04-03",
      "text": "收买价：C、E各1枚，D 2，B 100",
      "voiceText": "收买价：C和E各一枚，D两枚，B一百。",
      "scene": "04",
      "start": 35.275555555555556,
      "end": 39.44222222222222,
      "audio": null
    },
    {
      "id": "s04-04",
      "text": "买下C和E，船长留98枚，\n3票通过！",
      "voiceText": "买下C和E，船长留九十八，三票通过！",
      "scene": "04",
