  "captions": [
    {
      "id": "s01-01",
      "text": "100枚金币，船长独吞98枚！",
      "voiceText": "一百枚金币，船长独吞九十八枚！",
      "scene": "01",
      "start": 0.22,
      "end": 3.6682758620689655,
      "audio": null
    },
    {
      "id": "s01-02",
      "text": "这个方案，居然投票通过了？",
      "voiceText": "这个方案，居然投票通过了！凭什么？",
      "scene": "01",
      "start": 3.8182758620689654,
      "end": 7.531803713527852,
      "audio": null
    },
    {
      "id": "s02-01",
      "text": "船长提方案，全员投票，\n赞成≥一半通过，否则下海",
      "voiceText": "规则：船长提方案，全员投票，赞成达到一半就通过；不然提议的人下海，换下一个人提。",
      "scene": "02",
      "start": 8.053333333333333,
      "end": 17.071900972590626,
      "audio": null
    },
    {
      "id": "s02-02",
      "text": "先保命，再多拿钱；\n钱一样多，宁愿看别人下海",
      "voiceText": "海盗都绝顶聪明：先保命，再多拿钱，钱一样多，宁愿看别人下海。",
      "scene": "02",
      "start": 17.22190097259063,
      "end": 23.853200707338637,
      "audio": null
    },
    {
      "id": "s03-01",
      "text": "别从船长想，倒着推：\n先看只剩2个人",
      "voiceText": "别从船长想，倒着推：先看只剩最后两个人。",
      "scene": "03",
      "start": 24.35333333333333,
      "end": 28.86261715296198,
      "audio": null
    },
    {
      "id": "s04-01",
      "text": "只剩D、E：D全拿100枚。",
      "voiceText": "只剩D和E：D全拿一百枚。",
      "scene": "04",
      "start": 29.386666666666663,
      "end": 32.30443854995579,
      "audio": null
    },
    {
      "id": "s04-02",
      "text": "D自己1票，正好一半，通过！",
      "voiceText": "D自己一票，正好一半，通过！",
      "scene": "04",
      "start": 32.45443854995579,
      "end": 35.372210433244916,
      "audio": null
    },
    {
      "id": "s05-01",
      "text": "加上C：C需要2票。",
      "voiceText": "再加上C，他需要两票。",
      "scene": "05",
      "start": 35.88666666666666,
      "end": 38.27393457117595,
      "audio": null
    },
    {
      "id": "s05-02",
      "text": "想想E：C要是下海，E一枚都没有。",
      "voiceText": "想想E：C要是下海，E一枚都没有。",
      "scene": "05",
      "start": 38.42393457117595,
      "end": 42.13746242263483,
      "audio": null
    },
    {
      "id": "s05-03",
      "text": "所以给E 1枚就够：1枚＞0枚。",
      "voiceText": "所以给E一枚就够，一枚比零枚强。",
      "scene": "05",
      "start": 42.28746242263483,
      "end": 46.000990274093716,
      "audio": null
    },
    {
      "id": "s05-04",
      "text": "给0枚呢？钱一样，E宁愿看C下海。",
      "voiceText": "给零枚呢？钱一样，E宁愿看C下海。",
      "scene": "05",
      "start": 46.150990274093715,
      "end": 49.8645181255526,
      "audio": null
    },
    {
      "id": "s05-05",
      "text": "C 99，D 0，E 1，2票通过！",
      "voiceText": "C九十九，D零，E一，两票通过！",
      "scene": "05",
      "start": 50.0145181255526,
      "end": 53.19754199823164,
      "audio": null
    },
    {
      "id": "s06-01",
      "text": "收买价＝对方下一轮能拿的＋1。",
      "voiceText": "记住：收买价，就是对方下一轮能拿的，再加一。",
      "scene": "06",
      "start": 53.72,
      "end": 58.494535809018565,
      "audio": null
    },
    {
      "id": "s06-02",
      "text": "四人局，B该收买谁？\n评论区写答案，下集揭晓！",
      "voiceText": "四个人时，B该收买谁？评论区写答案，下集揭晓！",
