{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Short Video Factory topic content",
  "type": "object",
  "required": ["id", "subject", "title", "brand", "model", "scenes"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
    "subject": {"enum": ["math", "history", "physics", "chemistry"]},
    "title": {"type": "string", "minLength": 1},
    "brand": {"type": "string", "minLength": 1},
    "model": {"type": "object"},
    "sources": {"type": "array", "items": {"type": "object", "required": ["claim", "reference"], "properties": {"claim": {"type": "string"}, "reference": {"type": "string"}}}},
    "scenes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "title", "plannedSeconds", "cues"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "plannedSeconds": {"type": "number", "exclusiveMinimum": 0},
          "cues": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "text", "voiceText"], "properties": {"id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"}, "text": {"type": "string", "minLength": 1, "maxLength": 52}, "voiceText": {"type": "string", "minLength": 1}}}}
        }
      }
    }
  }
}
